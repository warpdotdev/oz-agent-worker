#!/bin/sh
set -eu

if [ -z "${INFISICAL_AGENT_VAULT_SESSION_TOKEN:-}" ] || [ -z "${INFISICAL_AGENT_VAULT_PROXY_ADDRESS:-}" ]; then
    printf '%s\n' 'Agent Vault session and proxy address are required' >&2
    exit 1
fi

# Override bypass variables so ambient configuration cannot route this call directly.
export NO_PROXY= no_proxy=
if ! response=$(infisical agent-vault run --no-skills --no-mcp-servers --telemetry=false -- \
    curl -q --silent --fail --max-time 30 --proto '=https' \
    -H 'Accept: application/vnd.github+json' \
    -H 'X-GitHub-Api-Version: 2022-11-28' \
    https://api.github.com/user 2>/dev/null); then
    printf '%s\n' 'Agent Vault GitHub request failed; no direct retry attempted' >&2
    exit 1
fi
if ! login=$(printf '%s' "$response" | jq -er \
    '.login | select(type == "string" and test("^[A-Za-z0-9][A-Za-z0-9-]{0,38}$"))' 2>/dev/null); then
    printf '%s\n' 'GitHub returned an invalid account identity' >&2
    exit 1
fi
printf '%s\n' "$login"
